# Where the browser sends API calls.
# Default "/api/v1" works with the Vite dev proxy (below) and with the Docker/nginx setup.
# Set a full URL (e.g. https://api.example.com/api/v1) only if the API lives on another domain —
# then the API needs COOKIE_SAME_SITE=none and HTTPS.
VITE_API_URL=/api/v1

# Dev server only: where /api and /r are proxied to.
VITE_PROXY_TARGET=http://localhost:5000
