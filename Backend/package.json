{
  "name": "url-shortener-backend",
  "version": "2.0.0",
  "description": "URL shortener API with OTP auth (Brevo email), Redis-cached redirects, BullMQ workers and click analytics",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker/index.js",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.8",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "i18next": "^26.3.6",
    "i18next-fs-backend": "^2.6.7",
    "i18next-http-middleware": "^3.9.8",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@apidevtools/swagger-parser": "^12.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3"
  }
