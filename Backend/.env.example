# ───────── Server ─────────
PORT=5000
NODE_ENV=development
# Public URL of THIS API. Short links are built as  <BASE_URL>/r/<code>
BASE_URL=http://localhost:5000
# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally, 1 on Render/Heroku/Nginx)
TRUST_PROXY=0

# ───────── Database & cache ─────────
MONGODB_URI=mongodb://127.0.0.1:27017/url_shortener
REDIS_URL=redis://127.0.0.1:6379

# ───────── Auth ─────────
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
OTP_TTL_SECONDS=600

# ───────── Cookies ─────────
# Same-site deployments (or the Vite dev proxy): lax.
# Frontend and API on different sites in production: none (requires HTTPS).
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ───────── Email (Brevo) ─────────
# Create a key at Brevo → SMTP & API → API Keys. Leave BREVO_API_KEY empty in development:
# OTP codes are then printed in the server log instead of being emailed.
BREVO_API_KEY=
# Must be a sender (or domain) you verified in Brevo → Senders, Domains & Dedicated IPs.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Trimly

# ───────── Optional ─────────
SENTRY_DSN=
# Run the BullMQ workers inside the API process (set false and run `npm run worker` separately to scale)
RUN_WORKERS_IN_API=true
SWAGGER_ENABLED=true
